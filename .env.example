# Copier vers Lovable → Cloud → Secrets (ne jamais committer les valeurs secrètes)

# Déjà présents pour Supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# LOVABLE_CRON_SECRET=

# Web Push — obligatoire pour les notifications téléphone / ordinateur hors app
VAPID_PUBLIC_KEY=BFqxxZFQiEie28e9tkPUPhWzGhwwRmPYePWCdbC85UiDM6rZzKLxbXsJeDYbUA8JLul4Q7Mcf9oZcO_DwNVaHrI
VAPID_PRIVATE_KEY=remplace-par-la-cle-privee
VAPID_SUBJECT=mailto:noreply@collabland-notify.lm-music.com

# Optionnel : secret pour /api/push/dispatch (sinon LOVABLE_CRON_SECRET)
# PUSH_DISPATCH_SECRET=

# Admin dashboard (ton user id UUID, séparés par des virgules si plusieurs)
ADMIN_USER_IDS=eb454a4f-4560-48b6-8bc0-34a2778fb4dd

# Email(s) qui reçoivent une alerte à chaque nouvelle inscription (virgules si plusieurs)
# Si vide : utilise les emails des comptes listés dans app_admins (nécessite SERVICE_ROLE)
ADMIN_NOTIFY_EMAIL=ton-email@exemple.com
